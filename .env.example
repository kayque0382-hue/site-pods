# Copie para .env (local) ou cadastre estas variáveis no painel da hospedagem.
# Nunca envie o arquivo .env para o GitHub.

# WhatsApp do vendedor: DDI + DDD + número, só dígitos
WHATSAPP=5511999998888

# Login do administrador
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-longa
# Opcional, mais seguro: use um hash em vez da senha em texto (gere com: npm run hash -- "sua-senha")
# ADMIN_PASSWORD_HASH=

# Texto aleatório longo, usado para assinar a sessão (ex.: openssl rand -hex 32)
SESSION_SECRET=

NODE_ENV=production

# Caminho do arquivo de produtos. Aponte para um disco persistente na hospedagem (ex.: /data/products.json)
# DATA_FILE=/data/products.json
